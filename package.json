{
  "name": "pfc_quartermaster",
  "version": "1.2.0",
  "description": "The Pyro Freelancer Corps Discord Bot",
  "main": "bot.js",
  "scripts": {
    "prestart": "node -e \"process.stdout.write('\\x1Bc')\" && npm install",
    "pretest": "node scripts/generateSwagger.js",
    "start": "node bot.js",
    "test": "node --no-deprecation -e \"process.stdout.write('\\x1Bc')\" && jest",
    "snapshot": "node scripts/runGuildSnapshot.js",
    "setup": "node -e \"process.stdout.write('\\x1Bc')\" && npm ci --no-audit && npm test"
  },
  "author": "Kenneth Hart",
  "license": "ISC",
  "dependencies": {
    "@discordjs/builders": "^1.2.0",
    "@discordjs/rest": "^1.1.0",
    "@discordjs/voice": "^0.19.0",
    "cheerio": "^1.0.0",
    "chrono-node": "^2.8.0",
    "cors": "^2.8.5",
    "discord.js": "^14.15.2",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.7.15",
    "moment": "^2.30.1",
    "mysql2": "^3.9.7",
    "openai": "^4.0.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sequelize": "^6.37.3",
    "sherpa-onnx-node": "^1.13.0"
  },
  "nodeVersion": "22.13.1"
}
